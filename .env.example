# Required by the public Vercel functions.
SILICONFLOW_API_KEY=replace_with_your_key

# Optional public Vending Machine settings.
VENDING_MODEL=deepseek-ai/DeepSeek-V4-Flash
VENDING_RATE_LIMIT=60
# Optional separate HMAC key for 20-minute calibration tickets.
# Falls back to SILICONFLOW_API_KEY when omitted.
VENDING_STATE_SECRET=

# Optional local development port.
PORT=3000
